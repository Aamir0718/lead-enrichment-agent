# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override Groq's per-token cost estimate used for the cost-
# tracking feature (USD per 1M tokens). See https://console.groq.com/docs
# for current pricing if you change GROQ_MODEL.
# GROQ_INPUT_COST_PER_1M=0.15
# GROQ_OUTPUT_COST_PER_1M=0.60

# Optional: minimum seconds between LLM calls, to stay under Groq's
# tokens-per-minute rate limit when domains run concurrently. Lower this
# if you're on a higher-tier Groq plan with more TPM headroom.
# GROQ_MIN_SECONDS_BETWEEN_CALLS=45

# Optional: how many domains to process concurrently (CLI and API).
# MAX_CONCURRENT_DOMAINS=3

# Optional bonus feature: LinkedIn/founder search for leadership not found
# on the company's own site. Get a free key at https://tavily.com -- the
# feature no-ops cleanly (no error) if this is left unset.
# TAVILY_API_KEY=your_tavily_api_key_here
